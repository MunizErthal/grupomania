rules_version = '2';
// Conteúdo do site: qualquer um lê; só o(s) administrador(es) escrevem.
// Administradores: usuários criados no Firebase Authentication.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['ismael@mania.com', 'marcia@mania.com'];
    }
    match /site/content {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
